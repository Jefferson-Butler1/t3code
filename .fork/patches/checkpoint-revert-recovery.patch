From df740d1a51ecf981002dd2e6c7f00efd33136042 Mon Sep 17 00:00:00 2001
From: Jefferson-Butler1 <jefferson.butler@icloud.com>
Date: Fri, 11 Sep 2026 16:07:29 -0700
Subject: [PATCH] fix(server): recover current files when conversation rewind
 fails

Capture file contents before checkpoint restoration and recover them if the provider rejects the rewind. Conversation-only rewinds remain unchanged, including non-Git workspaces.

Upstream fd5553f1a now handles paginated Codex history. This patch retains only file recovery and adapts to restoreFiles introduced in efccda9ac.

Validation: recovery regression fails on upstream; all 85 focused checkpoint and Codex runtime tests pass; server typecheck and targeted lint pass.
---
 apps/server/src/checkpointing/Utils.ts        |  6 ++
 .../Layers/CheckpointReactor.test.ts          | 85 ++++++++++++++++++-
 .../orchestration/Layers/CheckpointReactor.ts | 42 +++++++--
 3 files changed, 126 insertions(+), 7 deletions(-)

diff --git a/apps/server/src/checkpointing/Utils.ts b/apps/server/src/checkpointing/Utils.ts
index adc089f62..0845becd2 100644
--- a/apps/server/src/checkpointing/Utils.ts
+++ b/apps/server/src/checkpointing/Utils.ts
@@ -9,6 +9,12 @@ export function checkpointRefForThreadTurn(threadId: ThreadId, turnCount: number
   );
 }
 
+export function checkpointRefForRevertBase(threadId: ThreadId): CheckpointRef {
+  return CheckpointRef.make(
+    `${CHECKPOINT_REFS_PREFIX}/${Encoding.encodeBase64Url(threadId)}/revert-base`,
+  );
+}
+
 export function resolveThreadWorkspaceCwd(input: {
   readonly thread: {
     readonly projectId: ProjectId;
